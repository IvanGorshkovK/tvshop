# Настройки для backup.sh (скопируй в .backup.env на сервере и заполни)
# Эти переменные подхватываются скриптом и cron-задачей.

# --- Локальное хранение ---
# Сколько последних копий держать на сервере (ротация)
KEEP_DAYS=7

# --- S3-облако (необязательно, для выгрузки наружу) ---
# Пример для Yandex Object Storage. Selectel/Timeweb — аналогично.
S3_BUCKET=имя-бакета
S3_ENDPOINT=https://storage.yandexcloud.net
AWS_ACCESS_KEY_ID=сюда_ключ_доступа
AWS_SECRET_ACCESS_KEY=сюда_секретный_ключ
