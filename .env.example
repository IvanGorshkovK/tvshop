# ===== Настройки для продакшн-деплоя (docker-compose.prod.yml) =====
# Скопируй этот файл в .env на сервере и заполни значения.

# --- База данных PostgreSQL ---
POSTGRES_DB=tvshop
POSTGRES_USER=tvshop
POSTGRES_PASSWORD=СМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ

# --- Безопасность ---
# Длинная случайная строка (>= 32 символа). Сгенерируй, например: openssl rand -hex 32
JWT_SECRET=СМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ

# --- Сайт ---
# Разрешённые источники запросов (фронтенд). Укажи свой домен через запятую.
CORS_ORIGINS=https://tvspace.ru,http://localhost:5173
# Публичный адрес сайта (для sitemap.xml / robots.txt). Пусто, если домена пока нет.
SITE_URL=https://tvspace.ru
# Публичный адрес бэкенда (для абсолютных ссылок на картинки). Обычно пусто.
BASE_URL=

# --- AI (необязательно) ---
DEEPSEEK_API_KEY=

# --- Почта для восстановления пароля (SMTP) ---
# Если SMTP_HOST пустой — восстановление работает в демо-режиме (ссылка показывается на странице).
# Пример: Yandex smtp.yandex.ru, Mail.ru smtp.mail.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
